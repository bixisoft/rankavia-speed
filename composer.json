{
    "name": "bixisoft/rankavia-speed",
    "description": "Rankavia Speed – Core Web Vitals & Page Speed for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "bixisoft/core-php": "*"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/core-php",
            "options": {
                "symlink": false
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Bixisoft\\RankaviaSpeed\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "7.4.33"
        }
    }
}
